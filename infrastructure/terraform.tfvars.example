aws_region   = "eu-central-1"
project_name = "moaaz-3tier-devsecops"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

subnet_config = {
  "eu-central-1a" = {
    public_cidr  = "10.0.1.0/24"
    private_cidr = "10.0.11.0/24"
  }

  "eu-central-1b" = {
    public_cidr  = "10.0.2.0/24"
    private_cidr = "10.0.12.0/24"
  }
}

kubernetes_version = "1.35"

# Replace with the public IP allowed to access the EKS API.
cluster_endpoint_public_access_cidrs = [
  "YOUR_PUBLIC_IP/32"
]

node_instance_type = "t3.medium"

node_desired_size = 2
node_min_size     = 2
node_max_size     = 3

azure_devops_role_name = "azure-devops-ecr-push-role"
